---
import MainLayout from "../layouts/MainLayout.astro";
import TechIcon from "../components/TechIcon.astro";
import ExperienceItem from "../components/ExperienceItem.astro";
import { projects } from "../data/projects";

const companies = [
  {
    name: "Universidad Técnica Federico Santa María",
    roles: [
      { title: "Ayudante de Cátedra Redes de Computadores I", date: "ago. 2026 - Presente", description: "Ayudante de contacto para estudiantes de Ingeniería Civil Electrónica e Ingeniería Civil Telemática para el ramo ELO322 - Redes de Computadores. Realizo apoyo a los temas vistos en la cátedra para reforzar el aprendizaje."},
      { title: "Subcoordinador General / Difusión Telemática", date: "oct. 2024 - Presente", description: "Representante de la carrera en eventos de promoción, evangelizando sobre por qué Ingeniería Civil Telemática es el futuro."},
      { title: "Ayudante de Cátedra Proyecto Inicial", date: "mar. 2025 - jul. 2026", description: "Ayudante para estudiantes de Ingeniería Civil Telemática e Ingeniería Civil en Plan Común en sus primeros pasos en ingeniería, impulsando proyectos innovadores, conectando la técnica con sus propios intereses y pasiones." }
    ]
  },
  {
    name: "Axiovista",
    roles: [
      { title: "Documentador Técnico", date: "sept. 2025 - feb. 2026", description: "Estructuración de procedimientos de fibra óptica para entrenamiento de modelos IA multiagente." }
    ]
  },
  {
    name: "Universidad de La Serena",
    roles: [
      { title: "Técnico en Electrónica / Verano", date: "ene. 2025 - mar. 2025", description: "Instalación de sistemas de telemetría en zonas rurales. Preparación de hardware en laboratorio, soldadura, carga de firmware y gestión de datos técnicos para operaciones en terreno." },
      { title: "Técnico en Electrónica / Invierno", date: "jul. 2024 - ago. 2024", description: "I+D para telemetría rural. Migración de transmisión de datos a redes desde 2G a 4G y optimización de uso de memoria en Arduino para mejorar la estabilidad del sistema." },
      { title: "Técnico en Electrónica", date: "ago. 2023 - mar. 2024", description: "Desarrollo de tecnología para gestión hídrica. Creación de una app en C# para automatizar la programación de microcontroladores e integración de módulos GPS/GSM. Despliegue e instalación en terreno de +30 sistemas de monitoreo en servicios sanitarios rurales." }
    ]
  },
  {
    name: "Ilustre Municipalidad de Ovalle",
    roles: [
      { title: "Personal de soporte para TI", date: "ene. 2023 - mar. 2023", description: "Soporte técnico integral a funcionarios. Diagnóstico y reparación de hardware, configuración de entornos Windows y mantenimiento de infraestructura de red (switches, routers y cableado) para asegurar la conectividad."}
    ]
  }
];

const volunteers = [
  {
    name: "Comunidad Linux y Open Source USM",
    roles: [
        { title: "Coordinador General & Cofundador", date: "sept. 2025 - Presente", description: "Gestor y Cofundador de la comunidad estudiantil dedicada a Open Source. Organización de eventos y espacios de aprendizaje." }
    ]
  },
  {
    name: "Centro de Estudiantes de Ingeniería Civil Telemática",
    roles: [
      { title: "Vicepresidente", date: "abr. 2025 - abr. 2026", description: "Gestión interna y organización de eventos para la comunidad de ingeniería civil telemática." }
    ]
  }
];
---

<MainLayout title="Projects & Work">
  <div class="mx-auto w-full max-w-[830px] px-4 pb-16 pt-10 md:px-[30px] md:pt-16">
    
    <h1 class="mb-12 inline-block border-b-[6px] border-zinc-600 pb-1 text-3xl font-bold text-ink">
      Projects.
    </h1>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {projects.map((p) => (
        <a href={p.href} class="group block border border-line rounded-lg p-5 transition-all duration-200 hover:-translate-y-1 hover:border-zinc-600 hover:shadow-[0_4px_16px_rgba(0,0,0,0.35)]">
          <h3 class="font-bold text-ink mb-1 transition-colors duration-200 group-hover:text-[#F763BF]">{p.name}</h3>
          <p class="text-sm text-ink/80 mb-4">{p.description}</p>
          <div class="flex w-full flex-row flex-wrap items-center gap-2">
            {p.stack.map((tech) => (
              <span class="flex items-center gap-1.5 rounded-md border border-line bg-surface px-3 py-1 text-xs font-medium text-ink/80 transition-transform duration-150 hover:scale-105 md:text-sm">
                <TechIcon name={tech} />
                {tech}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>

    <h2 class="mb-12 mt-20 inline-block border-b-[6px] border-zinc-600 pb-1 text-2xl font-bold text-ink">
      Work Experience.
    </h2>

    <div class="flex flex-col space-y-12">
      {companies.map((company) => (
        <ExperienceItem name={company.name} roles={company.roles} />
      ))}
    </div>

    <h2 class="mb-12 mt-20 inline-block border-b-[6px] border-zinc-600 pb-1 text-2xl font-bold text-ink">
      Volunteering.
    </h2>

    <div class="flex flex-col space-y-12">
      {volunteers.map((vol) => (
        <ExperienceItem name={vol.name} roles={vol.roles} />
      ))}
    </div>
  </div>
</MainLayout>
