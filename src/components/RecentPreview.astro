---
interface Props {
  title: string;
  date?: string;
  href: string;
}

const { title, date, href } = Astro.props;
---

<div class="flex items-baseline justify-between gap-4">
  <a
    href={href}
    class="link text-sm"
  >
    {title}
  </a>
  {date && (
    <p class="shrink-0 text-sm text-ink/60">
      <time>{date}</time>
    </p>
  )}
</div>