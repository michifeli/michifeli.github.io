---
// src/components/Hero.astro
interface Post {
  title: string;
  date?: string;
  href: string;
}

interface Props {
  posts?: Post[];
}

const { posts = [] } = Astro.props;
---

<section class="mt-[6.3rem] mb-12 flex flex-col items-center text-center md:mb-[7.2rem]">
  <img 
    src="/avatar.webp" 
    alt="Mitchel Rojas Rivera" 
    class="mb-5 h-[70px] w-[70px] rounded-full object-cover shadow-sm"
  />
  
  <h1 class="mb-0.5 text-[27.2px] font-bold text-ink">
    Mitchel Rojas Rivera
  </h1>
  
  <p class="mx-auto max-w-[393px] leading-[1.688] text-ink opacity-90">
  Estudiante de Ingeniería Civil Telemática en la USM,
  GNU/Linux & Open Source Advocate, <br> escribo y programo cosas.
  </p>

  <div class="mt-6 flex justify-center gap-4">
    <a
      href="https://github.com/michifeli"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub profile"
      title="GitHub"
      class="text-ink/60 transition-all duration-200 hover:scale-110 hover:text-[#fff]"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
        <title>GitHub</title>
        <path d="M12 .297c-6.63 0-12 5.373-12 12c0 5.303 3.438 9.8 8.205 11.385c.6.113.82-.258.82-.577c0-.285-.01-1.04-.015-2.04c-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729c1.205.084 1.838 1.236 1.838 1.236c1.07 1.835 2.809 1.305 3.495.998c.108-.776.417-1.305.76-1.605c-2.665-.3-5.466-1.332-5.466-5.93c0-1.31.465-2.38 1.235-3.22c-.135-.303-.54-1.523.105-3.176c0 0 1.005-.322 3.3 1.23c.96-.267 1.98-.399 3-.405c1.02.006 2.04.138 3 .405c2.28-1.552 3.285-1.23 3.285-1.23c.645 1.653.24 2.873.12 3.176c.765.84 1.23 1.91 1.23 3.22c0 4.61-2.805 5.625-5.475 5.92c.42.36.81 1.096.81 2.22c0 1.606-.015 2.896-.015 3.286c0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
      </svg>
    </a>
    <a
      href="https://www.linkedin.com/in/mitchelrojas/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="LinkedIn profile"
      title="LinkedIn"
      class="text-ink/60 transition-all duration-200 hover:scale-110 hover:text-[#0A66C2]"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
        <title>LinkedIn</title>
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037c-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85c3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065c0-1.138.92-2.063 2.063-2.063c1.14 0 2.064.925 2.064 2.063c0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
      </svg>
    </a>
  </div>
</section>

<div class="mx-auto w-full max-w-[830px] space-y-12 px-4 pb-16 md:px-[30px]">

  <!-- Recent Post -->
  <div class="grid grid-cols-12 gap-4">
    <div class="col-span-12 sm:col-span-4 border-t border-line pt-4">
      <h2 class="font-bold text-ink text-base mb-1">Posts Recientes</h2>
      <div class="flex gap-3 text-xs">
        <a href="/writing" class="link">Ver todo</a>
        <a href="/rss.xml" class="link">Rss</a>
      </div>
    </div>
    <div class="col-span-12 sm:col-span-8 sm:border-t sm:border-line pt-4">
      {posts.length > 0 && (
        <ul class="space-y-3">
          {posts.map((post) => (
            <li class="flex items-baseline justify-between gap-4">
              <a href={post.href} class="link text-sm">{post.title}</a>
              {post.date && (
                <time class="shrink-0 text-xs text-ink/50">{post.date}</time>
              )}
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>

</div>
