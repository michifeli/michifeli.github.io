---

---

<div id="ascii-particles" transition:persist aria-hidden="true"></div>

<style is:global>
	:root {
		--particle-home: #9aa0ad;
		--particle-home-glow: #4b4f59;
		--particle-article: #7d8290;
		--particle-article-glow: #3f434d;
		--particle-volume: #8a8f9c;
		--particle-volume-glow: #454955;
		--text-font: "gohu", ui-monospace, "SFMono-Regular", Menlo, Consolas, "Liberation Mono", monospace;
		--text-size: 14px;
	}

	#ascii-particles {
		position: fixed;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
		contain: layout paint style;
	}

	#ascii-particles span {
		position: absolute;
		top: 0;
		left: 0;
		display: block;
		color: var(--particle-home);
		font-family: var(--text-font);
		font-size: calc(var(--text-size) + 1px);
		line-height: 1;
		opacity: 0;
		mix-blend-mode: screen;
		text-shadow: 0 0 4px var(--particle-home-glow);
		backface-visibility: hidden;
		will-change: opacity, transform;
	}

	#ascii-particles[data-particle-context="article"] span {
		color: var(--particle-article);
		text-shadow: 0 0 2px var(--particle-article-glow);
	}

	#ascii-particles[data-particle-context="volume"] span {
		color: var(--particle-volume);
		text-shadow: 0 0 3px var(--particle-volume-glow);
	}

	@media (prefers-reduced-motion: reduce) {
		#ascii-particles {
			display: none;
		}
	}
</style>

<script>
	const CHARS = [".", ".", "·", "·", ":", "'", "*"];

	const sample = (arr: string[]): string => arr[Math.floor(Math.random() * arr.length)];
	const rand = (min: number, max: number): number => min + Math.random() * (max - min);

	// Inicialización dentro de `astro:page-load` para que funcione con las
	// View Transitions: al navegar (Home -> About -> Home) el script se
	// re-ejecuta sobre el nuevo nodo del layout, en vez de quedarse anclado
	// al DOM de la primera carga (causa de que las partículas "desaparecieran").
	// El guard evita acumular listeners al re-ejecutarse el script inline
	// en cada navegación; el listener queda registrado una sola vez y Astro
	// dispara `astro:page-load` tras cada transición.
	//
	// Con `transition:persist` el MISMO nodo `#ascii-particles` sobrevive a la
	// navegación (mismo DOM, misma densidad, misma posición). Por eso, si ya
	// está inicializado (dataset.ready), no se toca nada: no se limpia, no se
	// repuebla ni se reinicia el loop.
	if (!(window as any).__particlesRegistered) {
		(window as any).__particlesRegistered = true;
		document.addEventListener("astro:page-load", () => {
		const layer = document.getElementById("ascii-particles");
		if (!layer) return;

		// Capa persistida por `transition:persist`: ya está viva y corriendo.
		if (layer.dataset.ready === "true") return;

		type Cleanup = () => void;
		const prevCleanup = (window as any).__particlesCleanup as Cleanup | undefined;
		if (typeof prevCleanup === "function") prevCleanup();

		// Sin distracciones mientras se lee un post markdown.
		const isMarkdownPost = /^\/writing\/[^/]+$/.test(window.location.pathname);
		if (isMarkdownPost || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			layer.remove();
			return;
		}

		layer.innerHTML = "";
		layer.removeAttribute("data-particle-context");

		const MOBILE_BREAKPOINT = 760;
		const CONTENT_SAFE_WIDTH = 760;
		const RADIUS = 180;
		const TAP_FORCE = 1.62;
		const TAP_RADIUS = 1.42;
		const TAP_DURATION = 620;
		const POINTER_FRAME_MS = 42;
		const DRIFT_X = [-0.28, 0.28] as const;
		const DRIFT_Y = [-0.72, -0.2] as const;
		const SPEED = [0.03, 0.085] as const;
		const BIG_CHANCE = 0.08;
		const BIG_RANGE = [1.4, 1.6] as const;

		const saveData = Boolean((navigator as any).connection?.saveData);
		const lowPower =
			((navigator as any).hardwareConcurrency ?? 8) <= 4 ||
			((navigator as any).deviceMemory ?? 8) <= 4;

		const contexts = {
			home: { desktopCount: 120, mobileCount: 60, opacity: [0.3, 0.55], pointerScale: 1, frameDesktop: 42, frameMobile: 50 },
			volume: { desktopCount: 60, mobileCount: 30, opacity: [0.22, 0.4], pointerScale: 0.72, frameDesktop: 52, frameMobile: 66 },
			article: { desktopCount: 40, mobileCount: 24, opacity: [0.16, 0.32], pointerScale: 0.45, frameDesktop: 78, frameMobile: 88 },
		} as const;

		const contextKey = window.location.pathname === "/" ? "home" : "article";
		const config = contexts[contextKey];
		layer.dataset.particleContext = contextKey;

		const BASE_SIZE =
			(parseFloat(getComputedStyle(layer).getPropertyValue("--text-size")) || 14) + 1;

		interface Particle {
			element: HTMLElement;
			x: number;
			y: number;
			vx: number;
			vy: number;
			baseOpacity: number;
			phase: number;
			speed: number;
		}

		const pointer = { x: NaN, y: NaN, active: false };
		const tap = { x: NaN, y: NaN, start: 0, active: false };
		let particles: Particle[] = [];
		let rafId = 0;
		let last = 0;

		const isMobile = (): boolean => window.innerWidth < MOBILE_BREAKPOINT;
		const frameMs = (): number =>
			(isMobile() ? config.frameMobile : config.frameDesktop) * (lowPower ? 1.15 : 1);
		const pointerFrameMs = (): number =>
			pointer.active || tap.active ? POINTER_FRAME_MS : frameMs();
		const targetCount = (): number => {
			const base = isMobile() ? config.mobileCount : config.desktopCount;
			const scale = saveData ? 0.45 : lowPower ? 0.68 : 1;
			return Math.max(4, Math.round(base * scale));
		};
		const spawnX = (w: number): number => {
			if (contextKey === "home" || w <= CONTENT_SAFE_WIDTH) return Math.random() * w;
			const gutter = (w - CONTENT_SAFE_WIDTH) / 2;
			const bound = gutter * 0.82;
			return Math.random() < 0.5 ? rand(0, bound) : rand(w - bound, w);
		};

		function resetParticle(p: Particle, anywhere: boolean): void {
			const fromEdge = (Math.random() * 4) | 0;
			const w = Math.max(1, window.innerWidth);
			const h = Math.max(1, window.innerHeight);

			if (anywhere || fromEdge === 0) {
				p.x = Math.random() * w;
				p.y = Math.random() * h;
			} else if (fromEdge === 1) {
				p.x = w + rand(4, 20);
				p.y = Math.random() * h;
			} else if (fromEdge === 2) {
				p.x = -rand(4, 20);
				p.y = Math.random() * h;
			} else {
				p.x = Math.random() * w;
				p.y = h + rand(4, 20);
			}

			p.vx = rand(DRIFT_X[0], DRIFT_X[1]);
			p.vy = rand(DRIFT_Y[0], DRIFT_Y[1]);
			p.baseOpacity = rand(config.opacity[0], config.opacity[1]);
			p.phase = Math.random() * Math.PI * 2;
			p.speed = rand(SPEED[0], SPEED[1]);
			p.element.textContent = sample(CHARS);
		}

		function spawn(): void {
			const count = targetCount();
			for (let i = 0; i < count; i++) {
				const el = document.createElement("span");
				el.textContent = sample(CHARS);
				const size =
					Math.random() < BIG_CHANCE ? BASE_SIZE * rand(BIG_RANGE[0], BIG_RANGE[1]) : BASE_SIZE;
				if (size !== BASE_SIZE) {
					const shift = (size - BASE_SIZE) / 2;
					el.style.fontSize = `${size.toFixed(1)}px`;
					el.style.marginTop = `-${shift.toFixed(1)}px`;
					el.style.marginLeft = `-${shift.toFixed(1)}px`;
				}
				layer.appendChild(el);
				const p: Particle = {
					element: el,
					x: 0,
					y: 0,
					vx: 0,
					vy: 0,
					baseOpacity: 0,
					phase: 0,
					speed: 0,
				};
				resetParticle(p, true);
				particles.push(p);
			}
		}

		function applyPointerInfluence(p: Particle, time: number, step: number): void {
			if (pointer.active) {
				const dx = p.x - pointer.x;
				const dy = p.y - pointer.y;
				const d = Math.hypot(dx, dy);
				if (d > 0 && d <= RADIUS) {
					const force = Math.pow(1 - d / RADIUS, 2);
					const scale = config.pointerScale;
					p.x += (dx / d) * force * scale * 1.8 * step;
					p.y += (dy / d) * force * scale * 1.2 * step;
					p.phase += force * scale * 0.08 * step;
				}
			}

			if (tap.active) {
				const elapsed = time - tap.start;
				if (elapsed >= TAP_DURATION) {
					tap.active = false;
					return;
				}
				const falloff = Math.pow(1 - elapsed / TAP_DURATION, 1.4);
				const radius = RADIUS * TAP_RADIUS * (0.72 + falloff * 0.28);
				const dx = p.x - tap.x;
				const dy = p.y - tap.y;
				const d = Math.hypot(dx, dy);
				if (d > 0 && d <= radius) {
					const force = Math.pow(1 - d / radius, 2);
					const scale = config.pointerScale * TAP_FORCE * falloff;
					p.x += (dx / d) * force * scale * 1.8 * step;
					p.y += (dy / d) * force * scale * 1.2 * step;
					p.phase += force * scale * 0.08 * step;
				}
			}
		}

		function animate(p: Particle, time: number, motionStep: number, pointerStep: number): void {
			p.x += p.vx * motionStep;
			p.y += p.vy * motionStep;
			applyPointerInfluence(p, time, pointerStep);
			p.phase += p.speed * motionStep;

			const flicker = 0.72 + Math.sin(time * 0.0017 + p.phase) * 0.28;
			p.element.style.opacity = (p.baseOpacity * flicker).toFixed(3);
			p.element.style.transform = `translate3d(${p.x.toFixed(2)}px, ${p.y.toFixed(2)}px, 0)`;

			if (p.y < -24 || p.y > innerHeight + 24 || p.x < -24 || p.x > innerWidth + 24) {
				resetParticle(p, false);
			}
		}

		function rebuild(): void {
			spawn();
			last = performance.now();
			const loop = (now: number): void => {
				// Si la capa fue removida del DOM (p. ej. se navegó a una página
				// sin partículas), detener el loop y liberar todo para que la
				// próxima página con partículas pueda inicializarse de cero.
				if (!layer.isConnected) {
					cleanup();
					return;
				}
				const elapsed = now - last;
				last = now;
				const motionStep = Math.min(elapsed / frameMs(), 3);
				const pointerStep = Math.min(elapsed / pointerFrameMs(), 3);
				for (let i = 0; i < particles.length; i++) {
					animate(particles[i], now, motionStep, pointerStep);
				}
				rafId = requestAnimationFrame(loop);
			};
			rafId = requestAnimationFrame(loop);
		}

		const onPointerMove = (e: PointerEvent): void => {
			pointer.x = e.clientX;
			pointer.y = e.clientY;
			pointer.active = true;
		};

		const onPointerDown = (e: PointerEvent): void => {
			tap.x = e.clientX;
			tap.y = e.clientY;
			tap.start = performance.now();
			tap.active = true;
		};

		const onPointerUp = (): void => {
			pointer.active = false;
		};

		const onLinkHover = (e: PointerEvent): void => {
			const target = e.target as HTMLElement | null;
			const link = target?.closest("a");
			if (!link) return;
			const rect = link.getBoundingClientRect();
			const cx = rect.left + rect.width / 2;
			const cy = rect.top + rect.height / 2;
			if (cx >= 0 && cy >= 0 && cx <= innerWidth && cy <= innerHeight) {
				tap.x = cx;
				tap.y = cy;
				tap.start = performance.now();
				tap.active = true;
			}
		};

		window.addEventListener("pointermove", onPointerMove);
		window.addEventListener("pointerdown", onPointerDown);
		window.addEventListener("pointerup", onPointerUp);
		window.addEventListener("pointerleave", onPointerUp);
		if (window.matchMedia("(hover: hover)").matches) {
			window.addEventListener("pointerover", onLinkHover);
		}

		const cleanup = (): void => {
			cancelAnimationFrame(rafId);
			window.removeEventListener("pointermove", onPointerMove);
			window.removeEventListener("pointerdown", onPointerDown);
			window.removeEventListener("pointerup", onPointerUp);
			window.removeEventListener("pointerleave", onPointerUp);
			window.removeEventListener("pointerover", onLinkHover);
			layer.dataset.ready = "";
		};

		layer.dataset.ready = "true";
		rebuild();

		(window as any).__particlesCleanup = cleanup;
		});
	}
</script>